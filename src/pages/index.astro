---
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import PixelSprite from '../components/PixelSprite.astro'
import Portrait from '../components/Portrait.astro'
import Window from '../components/Window.astro'
import { heart, note, sparkle } from '../data/sprites'
import { dialog, photos, profile, site, stages, stats, type Stage } from '../data/karina'

const pad = (n: number) => String(n).padStart(2, '0')
const ytSearch = (q: string) => `https://www.youtube.com/results?search_query=${encodeURIComponent(q)}`
const mvUrl = (s: Stage) => ytSearch(`${s.artist ?? 'aespa'} ${s.title} MV`)
const year = new Date().getFullYear()

// Solo se usan los audios que existen en public/ (o que son URLs)
const hasAudio = (src?: string): src is string =>
  !!src && (/^https?:\/\//.test(src) || existsSync(join(process.cwd(), 'public', src)))
const tracks = stages
  .filter((s) => hasAudio(s.audio))
  .map((s) => ({ src: s.audio!, title: s.artist ? `${s.title} · ${s.artist}` : s.title }))
const trackIndex = (s: Stage) => (hasAudio(s.audio) ? tracks.findIndex((t) => t.src === s.audio) : -1)

// Fotos locales en src/assets/fotos/ → optimizadas con <Image />; las URLs se usan tal cual
const localPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/fotos/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true },
)
const localPhoto = (src: string) => localPhotos[`../assets/fotos/${src}`]?.default
---

<Layout title={site.title} description={site.description}>
  <header class="hud" id="top">
    <div class="hud__left">
      <span class="hud__lives" aria-label="3 vidas">
        <PixelSprite rows={heart} px={2} />
        <PixelSprite rows={heart} px={2} />
        <PixelSprite rows={heart} px={2} />
      </span>
      <span class="hud__host" title="Dominio actual">
        <i class="hud__dot" aria-hidden="true"></i>
        <span class="hud__online">ONLINE</span>
        <span data-host>localhost</span>
        <span class="hud__ssl" data-ssl hidden>HTTPS ✓</span>
      </span>
    </div>
    <div class="hud__right">
      <nav class="hud__nav" aria-label="Secciones">
        <a href="#status">STATUS</a>
        <a href="#stages">STAGES</a>
        <a href="#memory">FOTOS</a>
      </nav>
      {
        tracks.length > 0 && (
          <button class="bgm" type="button" data-bgm={JSON.stringify(tracks)} aria-pressed="false">
            <span class="bgm__eq" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span>BGM</span>
            <span class="bgm__state" data-bgm-state>
              OFF
            </span>
          </button>
        )
      }
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero__text">
        <p class="hero__kicker">
          <PixelSprite rows={sparkle} px={2} />
          {site.kicker}
          <PixelSprite rows={sparkle} px={2} />
        </p>
        <h1 class="hero__title"><span>{site.name}</span></h1>
        <p class="hero__sub">{site.subtitle}</p>

        <div class="dialog">
          <p class="dialog__name">{site.name}</p>
          <p class="dialog__text" data-typewriter>{dialog}</p>
          <span class="dialog__next" aria-hidden="true">▼</span>
        </div>

        <div class="hero__actions">
          <a class="px-btn hero__start" href="#status">{site.startButton}</a>
          <a class="px-btn px-btn--ghost" href="#stages">{site.stagesButton}</a>
        </div>
      </div>

      <div class="hero__art">
        <Portrait />
        <p class="hero__hint">{site.hint}</p>
      </div>
    </section>

    <div class="sections">
      <Window title={site.statusTitle} id="status">
        <div class="status">
          <dl class="profile">
            {
              profile.map((row) => (
                <div class="profile__row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="stats" data-stats>
            <p class="stats__lv">LV <strong>99</strong> <span>MAX</span></p>
            {
              stats.map((s) => (
                <div class="stat">
                  <span class="stat__label">{s.label}</span>
                  <span class="stat__bar" style={`--v:${s.value}`}>
                    <i />
                  </span>
                  <span class="stat__value">{s.value}</span>
                </div>
              ))
            }
            <div class="stat stat--exp">
              <span class="stat__label">EXP</span>
              <span class="stat__bar stat__bar--exp" style="--v:100"><i /></span>
              <span class="stat__value">MAX</span>
            </div>
          </div>
        </div>
      </Window>

      <Window title={site.stagesTitle} id="stages">
        <ul class="stages">
          {
            stages.map((s, i) => {
              const track = trackIndex(s)
              const playable = track >= 0
              const Tag = playable ? 'button' : 'a'
              const props = playable
                ? { type: 'button', 'data-play': track, 'aria-pressed': 'false', 'aria-label': `Escuchar ${s.title}` }
                : { href: mvUrl(s), target: '_blank', rel: 'noopener noreferrer' }
              return (
                <li class:list={['stage', { 'stage--bonus': s.bonus }]} style={`--c:${s.color}`}>
                  <Tag class="stage__main" {...props}>
                    <span class="stage__label">
                      <span class="stage__num">{s.bonus ? 'BONUS' : `STAGE ${pad(i + 1)}`}</span>
                      <PixelSprite rows={note} px={3} class="stage__icon" />
                    </span>
                    <strong class="stage__title">{s.title}</strong>
                    <span class="stage__meta">
                      {s.artist ?? 'aespa'} · {s.year}
                    </span>
                    <span class="stage__play">
                      {playable ? (
                        <>
                          <span class="stage__idle">▶ PLAY</span>
                          <span class="stage__on">
                            <span class="bgm__eq" aria-hidden="true">
                              <i />
                              <i />
                              <i />
                            </span>
                            SONANDO
                          </span>
                        </>
                      ) : (
                        '▶ VER MV'
                      )}
                    </span>
                  </Tag>
                  {playable && (
                    <a
                      class="stage__mv"
                      href={mvUrl(s)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Ver el MV de ${s.title} en YouTube`}
                    >
                      MV ↗
                    </a>
                  )}
                </li>
              )
            })
          }
        </ul>
        {tracks.length > 0 && <p class="stages__tip">{site.stagesTip}</p>}
      </Window>

      <Window title={site.photosTitle} id="memory">
        <div class="slots">
          {
            photos.length > 0
              ? photos.map((p, i) => {
                  const local = localPhoto(p.src)
                  const alt = p.caption ?? `Foto ${i + 1} de Karina`
                  return (
                    <figure class="slot slot--photo" data-slot>
                      <button class="slot__toggle" type="button" aria-pressed="false">
                        <span class="sr-only">Ver en HD:</span>
                        <canvas class="slot__pixel" width="36" height="48" aria-hidden="true" />
                        {local ? (
                          <Image class="slot__img" src={local} alt={alt} width={600} data-pixelate />
                        ) : (
                          <img
                            class="slot__img"
                            src={p.src}
                            alt={alt}
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                            data-pixelate
                          />
                        )}
                        <span class="slot__error">
                          ERROR ✕<br />la foto no cargó
                        </span>
                      </button>
                      <figcaption class="slot__cap">
                        <span class="slot__num">
                          SLOT {pad(i + 1)}
                          {p.caption && ' · '}
                        </span>
                        {p.caption}
                      </figcaption>
                    </figure>
                  )
                })
              : [1, 2, 3].map((n) => (
                  <div class="slot slot--empty">
                    <PixelSprite rows={heart} px={5} />
                    <span class="slot__cap">SLOT {pad(n)}</span>
                    <span class="slot__state">{site.emptySlot}</span>
                  </div>
                ))
          }
        </div>
        {photos.length > 0 && <p class="slots__tip">{site.photosTip}</p>}
      </Window>
    </div>
  </main>

  <footer class="footer">
    <p class="footer__continue">
      CONTINUE? <a href="#top">▲ SÍ</a>
    </p>
    <p>{site.footer} · {year}</p>
    <p class="footer__legal">{site.legal}</p>
    <button class="footer__konami" type="button" data-supernova>↑↑↓↓←→←→ B A</button>
  </footer>

  <div class="toast" data-toast role="status" aria-live="polite"></div>
</Layout>

<script>
  // Dominio actual: útil para comprobar que el DNS apunta bien.
  document.querySelectorAll('[data-host]').forEach((el) => {
    el.textContent = location.host || 'localhost'
  })
  if (location.protocol === 'https:') {
    document.querySelectorAll<HTMLElement>('[data-ssl]').forEach((el) => (el.hidden = false))
  }

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Texto de diálogo estilo RPG
  const typed = document.querySelector<HTMLElement>('[data-typewriter]')
  if (typed && !reduceMotion) {
    const full = typed.textContent ?? ''
    typed.style.minHeight = `${typed.offsetHeight}px`
    typed.textContent = ''
    typed.closest('.dialog')?.classList.add('is-typing')
    let i = 0
    const tick = () => {
      i++
      typed.textContent = full.slice(0, i)
      if (i < full.length) setTimeout(tick, full[i - 1] === '.' ? 260 : 32)
      else typed.closest('.dialog')?.classList.remove('is-typing')
    }
    setTimeout(tick, 500)
  }

  // Barras de stats que se llenan al entrar en pantalla
  const statsEl = document.querySelector('[data-stats]')
  if (statsEl) {
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        statsEl.classList.add('is-visible')
        obs.disconnect()
      }
    }, { threshold: 0.3 }).observe(statsEl)
  }

  // Fotos pixeladas: se dibujan en un canvas diminuto y se escalan sin suavizado
  document.querySelectorAll<HTMLImageElement>('[data-pixelate]').forEach((img) => {
    const slot = img.closest<HTMLElement>('[data-slot]')!
    const canvas = slot.querySelector('canvas')!
    const draw = () => {
      const ctx = canvas.getContext('2d')
      if (!ctx || !img.naturalWidth) return
      const { width: cw, height: ch } = canvas
      const target = cw / ch
      const ratio = img.naturalWidth / img.naturalHeight
      let sw = img.naturalWidth
      let sh = img.naturalHeight
      if (ratio > target) sw = sh * target
      else sh = sw / target
      const sx = (img.naturalWidth - sw) / 2
      const sy = (img.naturalHeight - sh) * 0.3
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, cw, ch)
      slot.classList.add('is-loaded')
    }
    if (img.complete && img.naturalWidth) draw()
    else img.addEventListener('load', draw)
    img.addEventListener('error', () => slot.classList.add('is-error'))

  })

  // En celular no hay hover: tocar una foto la pone en HD (solo una a la vez).
  // Al sacar el cursor o el foco vuelve a pixel, así no se queda "pegada" en HD.
  const slots = [...document.querySelectorAll<HTMLElement>('[data-slot]')]
  const setHd = (slot: HTMLElement, on: boolean) => {
    slot.classList.toggle('is-hd', on)
    slot.querySelector('.slot__toggle')?.setAttribute('aria-pressed', String(on))
  }
  slots.forEach((slot) => {
    const toggle = slot.querySelector<HTMLButtonElement>('.slot__toggle')!
    toggle.addEventListener('click', () => {
      const on = !slot.classList.contains('is-hd')
      slots.forEach((s) => setHd(s, false))
      setHd(slot, on)
    })
    slot.addEventListener('mouseleave', () => setHd(slot, false))
    toggle.addEventListener('blur', () => setHd(slot, false))
  })

  const toast = document.querySelector<HTMLElement>('[data-toast]')!
  let toastTimer = 0
  const showToast = (text: string, ms = 2500) => {
    toast.textContent = text
    toast.classList.add('is-on')
    clearTimeout(toastTimer)
    toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), ms)
  }

  // Música: los navegadores no dejan reproducir audio sin un clic, así que empieza
  // apagada. Se enciende con el botón ♪ BGM o tocando una carta de SELECT STAGE.
  const bgm = document.querySelector<HTMLButtonElement>('[data-bgm]')
  if (bgm) {
    const tracks: { src: string; title: string }[] = JSON.parse(bgm.dataset.bgm ?? '[]')
    const state = bgm.querySelector<HTMLElement>('[data-bgm-state]')!
    const cards = [...document.querySelectorAll<HTMLButtonElement>('[data-play]')]
    const audio = new Audio()
    audio.preload = 'none'
    audio.volume = 0.5
    audio.loop = tracks.length === 1
    let current = 0

    const load = (i: number) => {
      current = (i + tracks.length) % tracks.length
      audio.src = tracks[current].src
      bgm.title = `♪ ${tracks[current].title}`
    }
    const render = () => {
      const on = !audio.paused
      bgm.classList.toggle('is-playing', on)
      bgm.setAttribute('aria-pressed', String(on))
      state.textContent = on ? 'ON' : 'OFF'
      cards.forEach((card) => {
        const active = on && Number(card.dataset.play) === current
        card.closest('.stage')?.classList.toggle('is-playing', active)
        card.setAttribute('aria-pressed', String(active))
      })
    }
    const play = () => audio.play().catch(render)

    load(0)
    audio.addEventListener('play', () => {
      render()
      showToast(`♪ ${tracks[current].title}`)
    })
    audio.addEventListener('pause', render)
    audio.addEventListener('ended', () => {
      load(current + 1)
      play()
    })
    audio.addEventListener('error', () => {
      render()
      showToast('✕ no se pudo cargar la canción')
    })

    bgm.addEventListener('click', () => (audio.paused ? play() : audio.pause()))
    cards.forEach((card) =>
      card.addEventListener('click', () => {
        const i = Number(card.dataset.play)
        if (i === current && !audio.paused) return audio.pause()
        if (i !== current) load(i)
        play()
      }),
    )
  }

  // Easter egg: código Konami → SUPERNOVA MODE
  let novaTimer = 0
  const supernova = () => {
    document.documentElement.classList.add('supernova')
    showToast('✦ SUPERNOVA MODE ✦', 6000)
    clearTimeout(novaTimer)
    novaTimer = window.setTimeout(() => document.documentElement.classList.remove('supernova'), 6000)
  }
  const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a']
  let pos = 0
  addEventListener('keydown', (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key
    pos = key === code[pos] ? pos + 1 : key === code[0] ? 1 : 0
    if (pos === code.length) {
      pos = 0
      supernova()
    }
  })
  document.querySelector('[data-supernova]')?.addEventListener('click', supernova)
</script>

<style>
  /* ---------- HUD ---------- */
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 24px;
    background: rgb(11 7 32 / 0.88);
    border-bottom: var(--p) solid var(--line);
    backdrop-filter: blur(6px);
  }

  .hud__left {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .hud__lives {
    display: flex;
    gap: 4px;
    flex: none;
  }

  .hud__host {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 15px;
    color: var(--muted);
    white-space: nowrap;
  }

  .hud__host [data-host] {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text);
  }

  .hud__dot {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--mint);
    box-shadow: 0 0 0 2px rgb(125 255 178 / 0.25);
    animation: blink-text 1.4s infinite;
  }

  .hud__online {
    font-family: var(--font-title);
    font-size: 8px;
    color: var(--mint);
  }

  .hud__ssl {
    font-family: var(--font-title);
    font-size: 8px;
    color: var(--yellow);
  }

  .hud__right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex: none;
  }

  .hud__nav {
    display: flex;
    gap: 20px;
  }

  .bgm {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 0;
    font-family: var(--font-title);
    font-size: 8px;
    line-height: 1;
    color: var(--text);
    background: var(--night-4);
    box-shadow:
      0 -2px 0 0 var(--line),
      0 2px 0 0 var(--line),
      -2px 0 0 0 var(--line),
      2px 0 0 0 var(--line);
  }

  .bgm__state {
    color: var(--muted);
  }

  .bgm.is-playing .bgm__state {
    color: var(--mint);
  }

  .bgm__eq {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .bgm__eq i {
    width: 2px;
    height: 2px;
    background: var(--pink);
  }

  .bgm.is-playing .bgm__eq i {
    animation: eq 0.6s steps(4) infinite alternate;
  }

  .bgm.is-playing .bgm__eq i:nth-child(2) {
    animation-delay: -0.2s;
  }

  .bgm.is-playing .bgm__eq i:nth-child(3) {
    animation-delay: -0.4s;
  }

  @keyframes eq {
    from {
      height: 2px;
    }
    to {
      height: 10px;
    }
  }

  .hud__nav a {
    font-family: var(--font-title);
    font-size: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .hud__nav a:hover {
    color: var(--yellow);
  }

  .hud__nav a:hover::before {
    content: '▶ ';
  }

  @media (max-width: 640px) {
    .hud {
      padding: 10px 16px;
    }

    .hud__nav,
    .hud__online {
      display: none;
    }
  }

  /* ---------- HERO ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 72px 32px 88px;
  }

  .hero__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-title);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--lilac);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-title);
    font-size: 80px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 4px;
  }

  .hero__title span {
    display: inline-block;
    padding-bottom: 8px;
    color: transparent;
    background: linear-gradient(
      180deg,
      #ffffff 0 38%,
      #ffe1f0 38% 56%,
      #ffa8c8 56% 74%,
      #d59bff 74% 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 4px 0 #6d3fd6) drop-shadow(4px 4px 0 var(--ink));
    animation: glitch 6s steps(1) infinite;
  }

  .hero__sub {
    margin: 0;
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--pink);
  }

  .dialog {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-top: 8px;
    padding: 26px 22px 22px;
    background: rgb(11 7 32 / 0.92);
    box-shadow:
      0 -4px 0 0 var(--line),
      0 4px 0 0 var(--line),
      -4px 0 0 0 var(--line),
      4px 0 0 0 var(--line),
      inset 0 0 0 4px var(--night-4),
      12px 12px 0 0 var(--drop);
  }

  .dialog__name {
    position: absolute;
    top: -14px;
    left: 16px;
    margin: 0;
    padding: 6px 10px;
    font-family: var(--font-title);
    font-size: 8px;
    line-height: 1;
    color: var(--ink);
    background: var(--pink);
    box-shadow:
      0 -2px 0 0 var(--ink),
      0 2px 0 0 var(--ink),
      -2px 0 0 0 var(--ink),
      2px 0 0 0 var(--ink);
  }

  .dialog__text {
    margin: 0;
  }

  .dialog__next {
    position: absolute;
    right: 14px;
    bottom: 8px;
    font-size: 12px;
    color: var(--yellow);
    animation: blink-text 1s infinite;
  }

  .dialog.is-typing .dialog__next {
    visibility: hidden;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 12px;
  }

  .hero__start {
    animation: pulse 1.2s steps(1) infinite;
  }

  .px-btn--ghost {
    color: var(--text);
    background: var(--night-4);
    box-shadow:
      0 -4px 0 0 var(--line),
      0 4px 0 0 var(--line),
      -4px 0 0 0 var(--line),
      4px 0 0 0 var(--line),
      inset -4px -4px 0 0 rgb(0 0 0 / 0.25),
      inset 4px 4px 0 0 rgb(255 255 255 / 0.12);
  }

  .hero__art {
    display: grid;
    justify-items: center;
    gap: 22px;
  }

  .hero__hint {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 56px;
      padding: 48px 24px 72px;
      text-align: center;
    }

    .hero__text {
      justify-items: center;
    }

    .hero__art {
      order: -1;
    }

    .dialog {
      text-align: left;
    }

    .hero__actions {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 40px 16px 64px;
    }

    .hero__title {
      font-size: 40px;
      letter-spacing: 2px;
    }
  }

  /* ---------- SECCIONES ---------- */
  .sections {
    display: grid;
    gap: 56px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px 96px;
  }

  @media (max-width: 640px) {
    .sections {
      gap: 44px;
      padding: 0 16px 72px;
    }
  }

